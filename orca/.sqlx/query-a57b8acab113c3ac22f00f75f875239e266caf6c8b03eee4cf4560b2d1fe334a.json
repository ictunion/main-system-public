  "query": "\nSELECT f.id\n, f.name\n, f.file_type AS \"file_type: FileType\"\n, f.created_at\nFROM members_files AS mf\nINNER JOIN files AS f ON f.id = mf.file_id\nWHERE mf.member_id = $1\nORDER BY f.created_at DESC\n",
