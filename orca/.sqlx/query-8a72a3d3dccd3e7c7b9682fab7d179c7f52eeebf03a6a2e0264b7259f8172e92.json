  "query": "\nSELECT rr.id\n, rr.created_at\n, rr.confirmed_at\n, rr.rejected_at\n, rr.invalidated_at\n, m.created_at AS \"accepted_at?\"\n, m.id AS \"member_id?\"\nFROM registration_requests AS rr\nLEFT JOIN members AS m ON rr.id = m.registration_request_id\nWHERE rr.id = $1\n",
