  "query": "\nUPDATE workplaces\nSET cancelled_at = NOW()\nWHERE id = $1\n  AND cancelled_at IS NULL\nRETURNING id\n    , name\n    , email\n    , created_at\n    , keycloak_group_id\n    , keycloak_executive_group_id\n    , announced_at\n    , established_at\n    , cancelled_at\n    , newsletter_id\n    , (SELECT COUNT(*) FROM members_workplaces mw WHERE mw.workplace_id = id)::bigint AS \"member_count!: i64\"\n",
