  "query": "\nSELECT id\n    , target_type AS \"target_type: NoteTarget\"\n    , COALESCE(registration_request_id, member_id, workplace_id) AS \"target_id!\"\n    , body\n    , author_sub\n    , author_name\n    , created_at\n    , updated_at\nFROM notes\nWHERE target_type = $1\n  AND (registration_request_id = $2 OR member_id = $2 OR workplace_id = $2)\nORDER BY created_at DESC, id\n",
