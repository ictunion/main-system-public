{
  "db_name": "PostgreSQL",
  "query": "\nSELECT o.id\n    , o.member_id\n    , m.member_number\n    , m.first_name\n    , m.last_name\n    , o.title\n    , o.elected_by\n    , o.elected_on\n    , o.term_ends_on\n    , o.created_at\n    , o.updated_at\nFROM member_offices AS o\nINNER JOIN members AS m ON m.id = o.member_id\nWHERE o.deleted_at IS NULL\nAND (o.term_ends_on IS NULL OR o.term_ends_on >= CURRENT_DATE)\nORDER BY o.elected_on DESC, m.member_number\n",
